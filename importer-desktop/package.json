{
  "name": "people-analytics-importer-desktop",
  "version": "1.0.0",
  "description": "Importador de Excel para People Analytics DAX Kit",
  "main": "main.js",
  "scripts": {
    "test": "node test-core.js",
    "dist:win": "electron-builder --win portable --x64",
    "generate": "node generate-report.cjs"
  },
  "dependencies": {
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.peopleanalytics.importer",
    "productName": "People Analytics Importer",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "core.js",
      "renderer/**/*",
      "package.json",
      "report-metrics.js",
      "report-period.js",
      "report-project.js",
      "generate-report.cjs",
      "locale.js",
      "report-language.js",
      "report-translations.json"
    ],
    "extraResources": [
      {
        "from": "../kit-free/PowerBI",
        "to": "PowerBI"
      },
      {
        "from": "../kit-plus/PowerBI",
        "to": "PowerBIPlus"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PeopleAnalyticsImporter-Desktop-next.exe"
    }
  }
}
